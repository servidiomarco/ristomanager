# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/ristomanager

# Environment
NODE_ENV=production

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=3000

# Frontend API Configuration
VITE_API_URL=https://ristomanager-production.up.railway.app

# Vonage WhatsApp API Configuration (sandbox / legacy — used as fallback)
VONAGE_API_KEY=c9e1ba38
VONAGE_API_SECRET=V5GhuDC!Zx%ASnsP98
VONAGE_WHATSAPP_NUMBER=971552980715

# Meta WhatsApp Business Cloud API — preferred when set.
# - ACCESS_TOKEN: System User permanent token from Meta Developers
# - PHONE_NUMBER_ID: assigned by Meta when the WhatsApp number is registered
# - TEMPLATE_NAME / TEMPLATE_LANG: approved template used for booking acks
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_TEMPLATE_NAME=booking_received
META_WHATSAPP_TEMPLATE_LANG=it

# Vonage Voice DID — bound to the ElevenLabs SIP trunk
# (E.164 without leading +; dev/test uses a UK number until porting)
VONAGE_VOICE_NUMBER=447451263812

# ElevenLabs Conversational AI
# Webhook secret used to verify HMAC-SHA256 signatures on tool/post-call requests.
# Agent ID is for logging/tracing only.
# API key is required to read conversations + stream audio from the ElevenLabs API
# (Conversazioni section in the CRM).
ELEVENLABS_WEBHOOK_SECRET=your_elevenlabs_webhook_secret_here
ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# JWT Authentication (generate secure random strings for production)
JWT_SECRET=your-secure-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=your-secure-refresh-secret-different-from-jwt-secret

# Default owner password (only used when seeding database for the first time)
DEFAULT_OWNER_PASSWORD=admin123
