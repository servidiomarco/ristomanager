# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/ristomanager

# Environment
NODE_ENV=production

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=3000

# Frontend API Configuration
VITE_API_URL=https://ristomanager-production.up.railway.app

# Public base URL used as StatusCallback for outbound Twilio messages so
# Twilio can notify us of delivery/failure. Defaults to VITE_API_URL when
# unset. Override only if the public URL differs (e.g. custom domain).
PUBLIC_WEBHOOK_BASE_URL=

# Vonage WhatsApp API Configuration (sandbox / legacy — used as fallback)
# ATTENZIONE: qui c'erano credenziali reali committate — vanno ruotate dal
# dashboard Vonage (Settings → API keys), il valore vecchio è compromesso.
VONAGE_API_KEY=la-tua-api-key
VONAGE_API_SECRET=il-tuo-secret
VONAGE_WHATSAPP_NUMBER=971552980715

# Twilio WhatsApp — preferred provider when set.
# - ACCOUNT_SID: Twilio Account SID (starts with "AC...")
# - AUTH_TOKEN: Twilio Auth Token (rotate from the console after deploy)
# - WHATSAPP_FROM: the WhatsApp sender, prefixed with "whatsapp:". The sandbox
#   sender is whatsapp:+14155238886; replace with the purchased number after
#   porting.
# - MESSAGING_SERVICE_SID: Twilio Messaging Service SID (starts with "MG..").
#   Required when the sender is an alphanumeric sender ID like "V Frantoio",
#   since alpha senders live inside a Messaging Service. If set, it takes
#   precedence over SMS_FROM.
# - SMS_FROM: SMS-capable Twilio number in E.164, OR a registered
#   alphanumeric sender ID (letters allowed, e.g. "V Frantoio"). When set —
#   together with MESSAGING_SERVICE_SID for alphanumeric senders — booking
#   confirmations go out as SMS instead of WhatsApp — temporary stand-in
#   while Meta WhatsApp verification is pending. Unset both to route
#   confirmations back through the WhatsApp chain.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_SMS_FROM=

# Meta WhatsApp Business Cloud API — preferred when set.
# - ACCESS_TOKEN: System User permanent token from Meta Developers
# - PHONE_NUMBER_ID: assigned by Meta when the WhatsApp number is registered
# - TEMPLATE_NAME / TEMPLATE_LANG: approved template used for booking acks
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_TEMPLATE_NAME=booking_received
META_WHATSAPP_TEMPLATE_LANG=it

# Content SID Twilio dei template WhatsApp approvati per reminder e avviso di
# modifica prenotazione (4 variabili: nome, ospiti, data, ora). Finché sono
# vuoti, reminder e avvisi partono via SMS.
TWILIO_WA_CONTENT_SID_BOOKING_REMINDER=
TWILIO_WA_CONTENT_SID_BOOKING_UPDATED=

# Vonage Voice DID — bound to the ElevenLabs SIP trunk
# (E.164 without leading +; dev/test uses a UK number until porting)
VONAGE_VOICE_NUMBER=447451263812

# ElevenLabs Conversational AI
# Webhook secret used to verify HMAC-SHA256 signatures on tool/post-call requests.
# Agent ID is for logging/tracing only.
# API key is required to read conversations + stream audio from the ElevenLabs API
# (Conversazioni section in the CRM).
ELEVENLABS_WEBHOOK_SECRET=your_elevenlabs_webhook_secret_here
ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Revolut Merchant API (hosted checkout / payment links)
# Default base points at sandbox — switch to https://merchant.revolut.com for prod.
# Signing secret comes from the "Add webhook" flow in the Revolut merchant portal
# after pointing the webhook at https://<host>/webhook/revolut.
REVOLUT_API_BASE=https://sandbox-merchant.revolut.com
REVOLUT_API_VERSION=2024-09-01
REVOLUT_API_KEY=
REVOLUT_WEBHOOK_SIGNING_SECRET=

# SumUp Online Payments (Hosted Checkout)
# All of these are only fallbacks: Settings → Integrazioni → SumUp stores the
# same values in the DB and wins field by field.
# SumUp serves sandbox and production from the same host (https://api.sumup.com)
# and tells them apart by the API key, so SUMUP_ENVIRONMENT selects which
# credential PAIR below is used rather than a base URL. Sandbox credentials come
# from a sandbox merchant account created in the SumUp developer settings.
# SUMUP_CALLBACK_SECRET is ours, not SumUp's: it's the opaque token embedded in
# the return_url we register on each checkout, so /webhook/sumup/:token can
# reject unrelated traffic. Leave it empty and one is generated on first save.
SUMUP_ENVIRONMENT=sandbox
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
SUMUP_SANDBOX_API_KEY=
SUMUP_SANDBOX_MERCHANT_CODE=
SUMUP_CALLBACK_SECRET=

# JWT Authentication (generate secure random strings for production)
JWT_SECRET=your-secure-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=your-secure-refresh-secret-different-from-jwt-secret

# Default owner password (only used when seeding database for the first time)
DEFAULT_OWNER_PASSWORD=admin123

# Email dell'owner creato al primo seed del database (default: admin@ristomanager.com)
DEFAULT_OWNER_EMAIL=admin@ristomanager.com

# Token che protegge gli endpoint /admin/tenants (provisioning piattaforma); senza, rispondono 503
PLATFORM_ADMIN_TOKEN=un-token-lungo-e-casuale

# Stripe — billing SaaS (fatturazione dei tenant). Senza SECRET_KEY il billing è spento.
STRIPE_SECRET_KEY=sk_test_la-tua-chiave
# Signing secret del webhook Stripe (Dashboard → Webhooks → endpoint /webhook/stripe)
STRIPE_WEBHOOK_SECRET=whsec_il-tuo-secret
# Price ID del piano base e dei moduli opzionali (Dashboard → Products)
STRIPE_PRICE_BASE=price_piano-base
STRIPE_PRICE_VOICE=price_modulo-voce
STRIPE_PRICE_WHATSAPP=price_modulo-whatsapp
STRIPE_PRICE_WEB_BOOKING=price_modulo-booking-web
STRIPE_PRICE_PAY_AT_TABLE=price_modulo-conto-al-tavolo

# Base URL della SPA CRM (link pay-at-table, callback) e del booking pubblico;
# i loro hostname entrano anche nella allowlist CORS (services/corsAllowlist.ts)
CRM_APP_BASE_URL=https://crm.vecchiofrantoio.com
PUBLIC_BOOKING_BASE_URL=https://prenotazioni.vecchiofrantoio.com

# Scappatoia CORS: true riapre tutte le origini (solo per debugging, com'era prima di D4)
CORS_ALLOW_ALL=
